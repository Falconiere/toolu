{
  "name": "@toolu/opencode",
  "version": "7.11.0",
  "description": "OpenCode plugin running toolu's native TypeScript gates in tool.execute.before.",
  "keywords": [
    "toolu",
    "opencode",
    "plugin",
    "quality-gate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Falconiere/toolu.git",
    "directory": "tools/toolu-opencode"
  },
  "homepage": "https://github.com/Falconiere/toolu/blob/main/docs/opencode.md",
  "bugs": {
    "url": "https://github.com/Falconiere/toolu/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "generated",
    "plugins"
  ],
  "scripts": {
    "prepack": "bun scripts/bundle-plugins.ts"
  },
  "type": "module",
  "main": "./src/plugin/toolu.ts",
  "exports": {
    ".": "./src/plugin/toolu.ts",
    "./host": "./src/host/index.ts",
    "./inventory": "./src/inventory/index.ts",
    "./select": "./src/select/index.ts",
    "./bootstrap": "./src/bootstrap/index.ts",
    "./preflight": "./src/preflight/index.ts",
    "./lifecycle": "./src/lifecycle/index.ts",
    "./plugin-stub": "./src/plugin/plugin-stub.ts",
    "./plugin": "./src/plugin/toolu.ts",
    "./adapter/permission-map": "./src/adapter/permission-map.ts",
    "./adapter/evaluate": "./src/adapter/evaluate.ts",
    "./adapter/tool-before": "./src/adapter/tool-before.ts"
  },
  "dependencies": {
    "@toolu/core": "^7.11.0",
    "gray-matter": "4.0.3",
    "zod": "4.1.5"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.18.34",
    "@opencode-ai/sdk": "1.18.34"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.34",
    "@opencode-ai/sdk": "1.18.34"
  }
}
