{
  "$schema": "../../tooling/conventions/guardrails/schema.json",
  "version": 2,
  "srcRoot": "src",
  "src": {
    "topLevel": [
      "adapter",
      "plugin",
      "host",
      "inventory",
      "select",
      "bootstrap",
      "preflight",
      "lifecycle"
    ],
    "nested": {
      "adapter": ["permission-map.ts", "evaluate.ts", "__tests__"],
      "plugin": ["plugin-stub.ts", "toolu.ts", "__tests__"],
      "host": ["types.ts", "detect.ts", "roots.ts", "__tests__"],
      "inventory": ["types.ts", "manifest.ts", "scan.ts", "selection.ts", "__tests__"],
      "select": ["resolve.ts", "__tests__"],
      "bootstrap": [
        "result.ts",
        "readiness.ts",
        "entrypoint.ts",
        "runtime.ts",
        "test-helpers.ts",
        "__tests__"
      ],
      "preflight": ["check.ts", "__tests__"],
      "lifecycle": ["table.ts", "__tests__"]
    },
    "requireReadme": []
  },
  "fileSize": { "max": 300, "skipExtensions": [".ts"] },
  "functionSize": { "max": 60 },
  "testDir": "__tests__",
  "testGlob": "*.test.ts",
  "barrelNames": ["index.ts", "index.tsx"],
  "barrelExempt": [
    "src/host/index.ts",
    "src/inventory/index.ts",
    "src/select/index.ts",
    "src/bootstrap/index.ts",
    "src/preflight/index.ts",
    "src/lifecycle/index.ts"
  ],
  "bannedDeps": ["axios", "yup", "joi", "valibot", "superstruct", "ajv"],
  "requiredFiles": [],
  "secrets": { "neverTracked": [".env", ".env.local"] },
  "shadowConfigs": [],
  "ownedByLinter": ["folder-tree", "colocated-tests", "no-barrels", "filename-case", "patterns"]
}
