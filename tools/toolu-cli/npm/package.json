  },
  "homepage": "https://github.com/Falconiere/toolu#readme",
  "bugs": {
    "url": "https://github.com/Falconiere/toolu/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "toolu-plugins": "cli.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "cli.js",
    "assets"
  ],
  "scripts": {
    "prepack": "mkdir -p assets && cp ../../../.claude-plugin/marketplace.json assets/marketplace.json"
  }
