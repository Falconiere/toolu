.claude/tmp/
.codex/tmp/
.opencode/tmp/
.toolu/tmp/
# Atomic-write leftovers (e.g. interrupted editor writes: file.sh.tmp.PID.HASH)
*.tmp.*

# Local workflow artifacts (specs/plans) — not shipped
docs/toolu/

# Dependencies
node_modules/

# Serena MCP tool cache
.serena/

# Local, per-machine Claude Code permissions — never shared
.claude/settings.local.json

# Cargo build output
/target/
# LLVM coverage output an instrumented binary writes into its working directory
*.profraw
# `claude plugin eval` run output (scores, traces, HTML report)
/plugins/*/evals/results/
