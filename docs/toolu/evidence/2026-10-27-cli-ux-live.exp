# Drives target/debug/toolu at a real terminal (expect allocates the pty).
# Usage: expect 2026-10-27-cli-ux-live.exp <toolu> <pick|cancel>
set timeout 120
set toolu [lindex $argv 0]
set mode [lindex $argv 1]
if {$mode eq "pick"} {
  spawn env NO_COLOR=1 $toolu plugins install --dry-run
  expect "Which hosts should receive the plugins?"
  sleep 0.3
  send "\033\[B"
  sleep 0.3
  send " "
  sleep 0.3
  send "\r"
  expect "Which plugins should be installed?"
  sleep 0.3
  send "\r"
  expect eof
} else {
  spawn sh -c "a=\$(stty -g); NO_COLOR=1 $toolu plugins install --dry-run; echo rc=\$?; b=\$(stty -g); \[ \"\$a\" = \"\$b\" \] && echo STTY_SAME"
  expect "Which hosts should receive the plugins?"
  sleep 0.3
  send "q"
  expect eof
}
