{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Falconiere/toolu/blob/main/docs/cli/commands.schema.json",
  "title": "toolu --json documents",
  "description": "The root validates `toolu commands --json` (toolu.commands/v1). $defs holds every other document a toolu command prints under --json.",
  "$ref": "#/$defs/commands",
  "$defs": {
    "commands": {
      "description": "toolu commands --json: the full command tree.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "name", "about", "hookProtocol", "exitCodes", "flags", "commands"],
      "properties": {
        "schema": { "const": "toolu.commands/v1" },
        "name": { "const": "toolu" },
        "about": { "type": "string" },
        "hookProtocol": { "type": "integer", "minimum": 1 },
        "exitCodes": { "type": "array", "items": { "$ref": "#/$defs/exitCode" } },
        "flags": { "type": "array", "items": { "$ref": "#/$defs/flag" } },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } }
      }
    },
    "exitCode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "meaning"],
      "properties": {
        "code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "name": { "type": "string", "pattern": "^[a-z]+$" },
        "meaning": { "type": "string", "minLength": 1 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "about", "longAbout", "aliases", "owner", "hidden", "placeholder", "flags", "args", "commands"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "path": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "about": { "type": "string" },
        "longAbout": { "type": ["string", "null"] },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "owner": { "type": "string", "minLength": 1 },
        "hidden": { "type": "boolean" },
        "placeholder": { "type": "boolean" },
        "flags": { "type": "array", "items": { "$ref": "#/$defs/flag" } },
        "args": { "type": "array", "items": { "$ref": "#/$defs/positional" } },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } }
      }
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["long", "short", "valueName", "takesValue", "required", "global", "hidden", "possibleValues", "help"],
      "properties": {
        "long": { "type": "string", "minLength": 1 },
        "short": { "type": ["string", "null"], "minLength": 1, "maxLength": 1 },
        "valueName": { "type": ["string", "null"] },
        "takesValue": { "type": "boolean" },
        "required": { "type": "boolean" },
        "global": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "possibleValues": { "type": "array", "items": { "type": "string" } },
        "help": { "type": "string" }
      }
    },
    "positional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "multiple", "help"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "multiple": { "type": "boolean" },
        "help": { "type": "string" }
      }
    },
    "error": {
      "description": "Any command under --json that ends with a non-zero exit and no document of its own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "name", "message", "suggestion"],
          "properties": {
            "code": { "type": "integer", "minimum": 1, "maximum": 255 },
            "name": { "type": "string", "pattern": "^[a-z]+$" },
            "message": { "type": "string" },
            "suggestion": { "type": ["string", "null"] }
          }
        }
      }
    },
    "version": {
      "description": "toolu --version --json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "hookProtocol"],
      "properties": {
        "name": { "const": "toolu" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
        "hookProtocol": { "type": "integer", "minimum": 1 }
      }
    },
    "help": {
      "description": "Any --help under --json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["help"],
      "properties": { "help": { "type": "string", "minLength": 1 } }
    },
    "planned": {
      "description": "toolu <namespace> planned --json, for a namespace not ported yet.",
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "ported", "planned", "issues"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "ported": { "const": false },
        "planned": { "type": "array", "items": { "type": "string" } },
        "issues": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
      }
    },
    "doctorCheck": {
      "description": "One toolu doctor check.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary", "hint", "details"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ok", "warn", "fail"] },
        "summary": { "type": "string", "minLength": 1 },
        "hint": { "type": ["string", "null"] },
        "details": { "type": "object" }
      }
    },
    "doctor": {
      "description": "toolu doctor --json. The report is on stdout even when a check failed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "ok", "checks"],
      "properties": {
        "namespace": { "const": "doctor" },
        "ok": { "type": "boolean" },
        "checks": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/doctorCheck" }
        }
      }
    },
    "config": {
      "description": "toolu config get|set|validate --json.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "key", "value", "files"],
          "properties": {
            "namespace": { "const": "config" },
            "key": { "type": ["string", "null"] },
            "value": {},
            "files": { "$ref": "#/$defs/configFiles" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "key", "value", "file"],
          "properties": {
            "namespace": { "const": "config" },
            "key": { "type": "string", "minLength": 1 },
            "value": {},
            "file": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "valid", "files", "warnings"],
          "properties": {
            "namespace": { "const": "config" },
            "valid": { "type": "boolean" },
            "files": { "$ref": "#/$defs/configFiles" },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "configFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "project"],
      "properties": {
        "user": { "type": "string" },
        "project": { "type": ["string", "null"] }
      }
    },
    "status": {
      "description": "toolu status --json, the same document StatusSnapshot returns.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "host",
        "cwd",
        "repo_root",
        "branch",
        "ahead",
        "behind",
        "working_tree",
        "gate",
        "push_review",
        "waivers"
      ],
      "properties": {
        "namespace": { "const": "status" },
        "host": { "type": "string" },
        "cwd": { "type": "string" },
        "repo_root": { "type": "string" },
        "branch": { "type": "string" },
        "ahead": { "type": "integer", "minimum": 0 },
        "behind": { "type": "integer", "minimum": 0 },
        "working_tree": { "$ref": "#/$defs/statusTree" },
        "gate": { "$ref": "#/$defs/statusGate" },
        "push_review": { "$ref": "#/$defs/statusReview" },
        "waivers": { "$ref": "#/$defs/statusWaivers" }
      }
    },
    "statusTree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staged", "unstaged", "untracked"],
      "properties": {
        "staged": { "type": "integer", "minimum": 0 },
        "unstaged": { "type": "integer", "minimum": 0 },
        "untracked": { "type": "integer", "minimum": 0 }
      }
    },
    "statusGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "entries"],
      "properties": {
        "status": { "enum": ["passing", "failing", "missing", "invalid"] },
        "reason": { "type": ["string", "null"] },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/statusGateEntry" }
        }
      }
    },
    "statusGateEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "source", "reason", "violations", "updatedAt"],
      "properties": {
        "file": { "type": "string" },
        "source": { "type": "string" },
        "reason": { "type": "string" },
        "violations": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "statusReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state", "reason", "document"],
      "properties": {
        "path": { "type": "string" },
        "state": { "enum": ["missing", "recorded", "invalid"] },
        "reason": { "type": ["string", "null"] },
        "document": { "type": ["object", "null"] }
      }
    },
    "statusWaivers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiver", "pending"],
      "properties": {
        "waiver": { "type": ["object", "null"] },
        "pending": { "type": ["object", "null"] }
      }
    },
    "setupAgents": {
      "description": "toolu setup agents prints text lines (TARGET, PLAN, then a summary or NOTICE). Refusals exit 2. Stdout is text, not JSON.",
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "command", "target", "plans"],
      "properties": {
        "namespace": { "const": "setup" },
        "command": { "enum": ["preview", "install", "remove"] },
        "target": { "type": "string", "minLength": 1 },
        "plans": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "action"],
            "properties": {
              "name": {
                "enum": [
                  "quick-task",
                  "deep-explore",
                  "research-agent",
                  "implementer",
                  "architect"
                ]
              },
              "action": {
                "enum": ["install", "unchanged", "update", "conflict", "absent", "remove"]
              }
            }
          }
        }
      }
    },
    "guide": {
      "description": "toolu <namespace> --json, for a Markdown-only plugin.",
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "about", "text"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "about": { "type": "string" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "empty": {
      "description": "A successful command under --json that has no data.",
      "type": "object",
      "maxProperties": 0
    },
    "ledger": {
      "description": "A plan ledger (version 1) as toolu ledger run and status write it.",
      "type": "object",
      "required": ["version", "branch", "base_branch", "plan_doc", "updated_at", "summary", "next", "steps"],
      "properties": {
        "version": { "const": 1 },
        "next": { "type": ["string", "null"] },
        "steps": { "type": "array", "items": { "type": "object" } }
      }
    },
    "ledgerRun": {
      "description": "toolu ledger run --json once a ledger was written.",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "ledger"],
      "properties": {
        "summary": { "type": ["string", "null"] },
        "ledger": { "$ref": "#/$defs/ledger" }
      }
    },
    "ledgerStatus": {
      "description": "toolu ledger status --json once a ledger was rewritten.",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "ledger", "ac_coverage"],
      "properties": {
        "summary": { "type": ["string", "null"] },
        "ledger": { "$ref": "#/$defs/ledger" },
        "ac_coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "covered", "steps"],
            "properties": {
              "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
              "covered": { "type": "boolean" },
              "steps": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "ledgerPath": {
      "description": "toolu ledger path --json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1 } }
    },
    "ledgerRoot": {
      "description": "toolu ledger root --json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": { "root": { "type": "string", "minLength": 1 } }
    },
    "ledgerSelfTest": {
      "description": "toolu ledger self-test --json when the self-test passes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": { "ok": { "const": true } }
    },
    "gate": {
      "description": "One verdict gate: its state, its reason, and gate-specific extras.",
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": { "enum": ["pass", "fail", "skip", "advise", "escalate"] },
        "reason": { "type": "string" }
      }
    },
    "verdict": {
      "description": "toolu ledger verdict json, and verdict status under --json: the four push gates.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "branch", "base_branch", "diff_sha", "overall", "gates", "generated_at"],
      "properties": {
        "version": { "const": 1 },
        "branch": { "type": "string" },
        "base_branch": { "type": "string" },
        "diff_sha": { "type": "string" },
        "overall": { "enum": ["ready", "blocked"] },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quality", "plan", "review", "docs"],
          "properties": {
            "quality": { "$ref": "#/$defs/gate" },
            "plan": { "$ref": "#/$defs/gate" },
            "review": { "$ref": "#/$defs/gate" },
            "docs": { "$ref": "#/$defs/gate" }
          }
        },
        "generated_at": { "type": "string" }
      }
    }
  }
}
