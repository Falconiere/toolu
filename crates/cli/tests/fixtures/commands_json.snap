      "flags": [],
      "hidden": false,
      "longAbout": "brainstorm is a Markdown-only plugin: it has no verbs. Its skill thinks a change through before building: evidence-backed triage, alternatives, trade-offs and a recommended approach, without editing code.\n\nRun it as /brainstorm:brainstorm in Claude Code or $brainstorm:brainstorm in Codex. delivery-flow runs it as its first phase.",
      "name": "brainstorm",
      "owner": "brainstorm",
      "path": [
        "brainstorm"
      ],
      "placeholder": false
    },
