  "exitCodes": [
    {
      "code": 0,
      "meaning": "the command did what was asked",
      "name": "success"
    },
    {
      "code": 1,
      "meaning": "the command ran and failed",
      "name": "failure"
    },
    {
      "code": 2,
      "meaning": "a hook or gate blocked or denied the action",
      "name": "blocked"
    },
    {
      "code": 64,
      "meaning": "the command line is wrong",
      "name": "usage"
    },
    {
      "code": 69,
      "meaning": "a dependency (for example `gh`) is missing or unreachable",
      "name": "unavailable"
    },
    {
      "code": 75,
      "meaning": "a temporary failure; the caller may retry",
      "name": "tempfail"
    }
  ],
