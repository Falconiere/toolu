        }
      ],
      "flags": [],
      "hidden": false,
      "longAbout": "ts-quality has no verbs: its rules run after every edit of a .ts or .tsx file in a TypeScript project with a package manager. Violations (type assertions, console.log, suppression comments, oversized files and functions, swallowed errors, mocks in tests and more) fail the file's quality-gate entry until it is fixed; duplication, JSDoc and unhandled-await findings are advisories.\n\nLimits come from lang.ts in toolu.config.json (maxFileLines, maxFnLines, noMocks). Run toolu doctor to see whether the rule is registered and compiled in.",
      "name": "ts-quality",
      "owner": "ts-quality",
      "path": [
        "ts-quality"
      ],
      "placeholder": false
    },
    {
      "about": "Python quality rules that run after each edit",
      "aliases": [],
      "args": [],
      "commands": [
        {
          "about": "Run a hook entry; hooks.json calls it (internal)",
          "aliases": [],
          "args": [
            {
              "help": "The hook entry, as its plugin's hooks.json names it",
              "multiple": false,
              "name": "NAME",
              "required": true
            }
          ],
          "commands": [],
          "flags": [
            {
              "global": false,
              "help": "The host event it is registered under; absent counts as enforcing",
              "hidden": false,
              "long": "event",
              "possibleValues": [],
              "required": false,
              "short": null,
              "takesValue": true,
