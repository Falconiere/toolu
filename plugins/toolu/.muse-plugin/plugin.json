{
  "schemaVersion": 1,
  "name": "toolu",
  "displayName": "toolu",
  "version": "8.1.3",
  "description": "Dual-host engineering discipline for Claude Code and Codex: workflow skills, agents, commands, and registry-driven quality hooks.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "commit",
        "path": "skills/commit/SKILL.md"
      },
      {
        "id": "debug",
        "path": "skills/debug/SKILL.md"
      },
      {
        "id": "deep-research",
        "path": "skills/deep-research/SKILL.md"
      },
      {
        "id": "orchestrator",
        "path": "skills/orchestrator/SKILL.md"
      },
      {
        "id": "review-and-commit",
        "path": "skills/review-and-commit/SKILL.md"
      },
      {
        "id": "setup",
        "path": "skills/setup/SKILL.md"
      }
    ],
    "commands": [
      {
        "id": "commit-command",
        "path": "commands/commit.md"
      },
      {
        "id": "doctor",
        "path": "commands/doctor.md"
      },
      {
        "id": "review-and-commit-command",
        "path": "commands/review-and-commit.md"
      },
      {
        "id": "status",
        "path": "commands/status.md"
      },
      {
        "id": "architect",
        "path": "agents/architect.md"
      },
      {
        "id": "deep-explore",
        "path": "agents/deep-explore.md"
      },
      {
        "id": "implementer",
        "path": "agents/implementer.md"
      },
      {
        "id": "quick-task",
        "path": "agents/quick-task.md"
      },
      {
        "id": "research-agent",
        "path": "agents/research-agent.md"
      }
    ],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "/bin/sh",
          "hooks/muse/session-start"
        ],
        "timeoutMs": 60000
      },
      {
        "id": "check-binary",
        "event": "SessionStart",
        "command": [
          "/bin/sh",
          "hooks/muse/check-binary"
        ],
        "timeoutMs": 60000
      },
      {
        "id": "pre-compact",
        "event": "PreCompact",
        "command": [
          "/bin/sh",
          "hooks/muse/pre-compact"
        ],
        "timeoutMs": 60000
      },
      {
        "id": "user-prompt-submit",
        "event": "UserPromptSubmit",
        "command": [
          "/bin/sh",
          "hooks/muse/user-prompt-submit"
        ],
        "timeoutMs": 60000
      },
      {
        "id": "pre-tools",
        "event": "PreToolUse",
        "command": [
          "/bin/sh",
          "hooks/muse/pre-tools"
        ],
        "timeoutMs": 60000
      },
      {
        "id": "mcp-tools",
        "event": "PreToolUse",
        "command": [
          "/bin/sh",
          "hooks/muse/mcp-tools"
        ],
        "timeoutMs": 60000
      },
      {
        "id": "agent-tier",
        "event": "PreToolUse",
        "command": [
          "/bin/sh",
          "hooks/muse/agent-tier"
        ],
        "timeoutMs": 60000
      },
      {
        "id": "post-tools",
        "event": "PostToolUse",
        "command": [
          "/bin/sh",
          "hooks/muse/post-tools"
        ],
        "timeoutMs": 60000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
