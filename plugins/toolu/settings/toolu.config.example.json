{
  "version": 1,
  "skills": {
    "comemory": true,
    "ast-grep": true
  },
  "agents": {
    "research-agent": true
  },
  "hooks": {
    "session-start": true,
    "user-prompt-submit": true,
    "pre-tools": true,
    "post-tools": true,
    "pre-compact": true,
    "session-end": true
  },
  "mcp": {},
  "models": {
    "enabled": true,
    "mechanical": "haiku",
    "exploration": "sonnet",
    "implementation": "sonnet",
    "review": "sonnet",
    "synthesis": "opus",
    "architecture": "opus"
  },
  "telemetry": {
    "enabled": true
  },
  "agentTier": {
    "mode": "advise"
  },
  "planLedger": {
    "blockOnUncoveredAcs": false
  },
  "docsSync": {
    "mode": "advise",
    "surfaces": ["README.md", "*/README.md", "docs/*.md", "*/SKILL.md"],
    "surfaceExcludes": ["docs/releases/*", "*/docs/releases/*"],
    "codeSurfaces": ["*.ts", "*.rs", "*.sh", "*/commands/*", "*plugin.json", "*.config.json"]
  },
  "lang": {
    "ts": { "maxFileLines": 300, "maxFnLines": 60, "noMocks": true },
    "rust": { "maxFileLines": 500, "maxFnLines": 50, "maxImplLines": 200, "noMocks": true }
  }
}
