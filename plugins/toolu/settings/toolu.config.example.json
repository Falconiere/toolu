{
  "version": 1,
  "gates": {
    "preset": "balanced",
    "pushReview": {
      "mode": "advise"
    },
    "qualityGate": {
      "mode": "block"
    },
    "commitGate": {
      "mode": "advise"
    },
    "bashCommands": {
      "mode": "advise"
    },
    "planLedger": {
      "mode": "advise"
    },
    "docsSync": {
      "mode": "advise"
    },
    "agentTier": {
      "mode": "advise"
    },
    "sweep": true,
    "stateTtlHours": 24,
    "telemetryRetentionDays": 7
  },
  "permissions": {
    "autoAllow": true,
    "allow": [
      "Bash(*)",
      "Edit",
      "Write"
    ]
  },
  "skills": {
    "comemory": true,
    "ast-grep": true
  },
  "projectSkills": {
    "enabled": true,
    "staleAfterDays": 30,
    "archiveAfterDays": 90,
    "indexCap": 20
  },
  "agents": {
    "research-agent": true
  },
  "hooks": {
    "session-start": true,
    "user-prompt-submit": true,
    "pre-tools": true,
    "post-tools": true,
    "pre-compact": true,
    "session-end": true
  },
  "mcp": {},
  "models": {
    "enabled": true,
    "mechanical": "haiku",
    "exploration": "sonnet",
    "implementation": "sonnet",
    "review": "sonnet",
    "synthesis": "opus",
    "architecture": "opus",
    "codex": {
      "mechanical": {
        "model": "gpt-5.6-luna",
        "reasoningEffort": "medium"
      },
      "exploration": {
        "model": "gpt-5.6-terra",
        "reasoningEffort": "medium"
      },
      "implementation": {
        "model": "gpt-5.6-terra",
        "reasoningEffort": "medium"
      },
      "review": {
        "model": "gpt-5.6-terra",
        "reasoningEffort": "high"
      },
      "synthesis": {
        "model": "gpt-5.6-sol",
        "reasoningEffort": "high"
      },
      "architecture": {
        "model": "gpt-5.6-sol",
        "reasoningEffort": "high"
      }
    }
  },
  "telemetry": {
    "enabled": true
  },
  "agentTier": {
    "mode": "advise"
  },
  "planLedger": {
    "blockOnUncoveredAcs": false
  },
  "docsSync": {
    "mode": "advise",
    "surfaces": [
      "README.md",
      "*/README.md",
      "docs/*.md",
      "*/SKILL.md"
    ],
    "surfaceExcludes": [
      "docs/releases/*",
      "*/docs/releases/*"
    ],
    "codeSurfaces": [
      "*.ts",
      "*.rs",
      "*.sh",
      "*/commands/*",
      "*plugin.json",
      "*.config.json"
    ]
  },
  "lang": {
    "ts": {
      "maxFileLines": 300,
      "maxFnLines": 60,
      "noMocks": true
    },
    "rust": {
      "maxFileLines": 500,
      "maxFnLines": 50,
      "maxImplLines": 200,
      "noMocks": true
    }
  }
}
