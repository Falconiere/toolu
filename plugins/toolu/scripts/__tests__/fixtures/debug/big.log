     | { id: $s.id, title: $s.title, check: $s.check,
-        status: $status, exit_code: $code, diff_sha: $sha,
+        status: $status,
+        started_at: (if $started_at == "" then null else $started_at end),
+        activity: (if $activity == "" then null else $activity end),
