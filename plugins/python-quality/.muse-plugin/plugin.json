{
  "schemaVersion": 1,
  "name": "python-quality",
  "displayName": "python-quality",
  "version": "8.4.0",
  "description": "Python PostToolUse quality checks registered into the toolu hook engine.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [],
    "commands": [],
    "hooks": [
      {
        "id": "register",
        "event": "SessionStart",
        "command": [
          "/bin/sh",
          "hooks/muse/register"
        ],
        "timeoutMs": 60000
      },
      {
        "id": "check-toolu",
        "event": "SessionStart",
        "command": [
          "/bin/sh",
          "hooks/muse/check-toolu"
        ],
        "timeoutMs": 60000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
