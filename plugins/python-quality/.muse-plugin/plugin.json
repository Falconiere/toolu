{
  "schemaVersion": 1,
  "name": "python-quality",
  "displayName": "python-quality",
  "version": "10.4.0",
  "description": "Python quality rules for checks and the push gate.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [],
    "commands": [],
    "hooks": [
      {
        "id": "forget",
        "event": "SessionStart",
        "command": [
          "/bin/sh",
          "hooks/muse/forget"
        ],
        "timeoutMs": 60000
      },
      {
        "id": "check-toolu",
        "event": "SessionStart",
        "command": [
          "/bin/sh",
          "hooks/muse/check-toolu"
        ],
        "timeoutMs": 60000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
