{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../tooling/conventions/lint/base.oxlintrc.json"
  ],
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "node_modules",
    "fixtures",
    "**/__tests__/**"
  ],
  "rules": {
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 60,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/index",
              "**/index.js",
              "**/index.ts"
            ],
            "message": "No barrel imports"
          },
          {
            "group": [
              "yup",
              "yup/*",
              "joi",
              "joi/*",
              "valibot",
              "valibot/*",
              "superstruct",
              "superstruct/*",
              "ajv",
              "ajv/*"
            ],
            "message": "One validator: use zod"
          }
        ]
      }
    ]
  },
  "overrides": [
    {"files":["epic-orchestrator/scripts/admission.ts"],"rules":{"import/no-duplicates":"off","max-lines-per-function":"off"}},
    {"files":["epic-orchestrator/scripts/checkouts.ts"],"rules":{"typescript/consistent-type-assertions":"off","typescript/no-unsafe-type-assertion":"off","typescript/prefer-optional-chain":"off"}},
    {"files":["epic-orchestrator/scripts/checkpoint.ts"],"rules":{"import/no-duplicates":"off","max-lines":"off","max-lines-per-function":"off","no-await-in-loop":"off"}},
    {"files":["epic-orchestrator/scripts/common.ts"],"rules":{"import/no-duplicates":"off","typescript/consistent-type-assertions":"off","typescript/no-unnecessary-condition":"off","typescript/no-unsafe-type-assertion":"off","typescript/prefer-nullish-coalescing":"off","typescript/prefer-optional-chain":"off","typescript/require-await":"off"}},
    {"files":["epic-orchestrator/scripts/epic-close.ts"],"rules":{"no-restricted-imports":"off"}},
    {"files":["epic-orchestrator/scripts/epic-graph.ts"],"rules":{"max-lines":"off","max-lines-per-function":"off","no-await-in-loop":"off","no-restricted-imports":"off","typescript/consistent-type-assertions":"off","typescript/no-unsafe-type-assertion":"off","unicorn/consistent-function-scoping":"off","unicorn/no-array-sort":"off"}},
    {"files":["epic-orchestrator/scripts/epic-watch.ts"],"rules":{"import/no-duplicates":"off","max-lines":"off","max-lines-per-function":"off","no-await-in-loop":"off","typescript/consistent-type-assertions":"off","typescript/no-unnecessary-condition":"off","typescript/no-unsafe-type-assertion":"off","unicorn/no-array-reverse":"off","unicorn/no-array-sort":"off"}},
