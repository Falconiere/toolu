{
  "schemaVersion": 1,
  "name": "statusline",
  "displayName": "statusline",
  "version": "8.1.4",
  "description": "Native Claude Code statusline and Codex status skills for repository and gate status. Standalone, no dependencies.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "status",
        "path": "skills/status/SKILL.md"
      }
    ],
    "commands": [
      {
        "id": "setup",
        "path": "commands/setup.md"
      }
    ],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "/bin/sh",
          "hooks/muse/session-start"
        ],
        "timeoutMs": 60000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
