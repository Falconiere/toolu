{
  "schemaVersion": 1,
  "name": "toolu-review",
  "displayName": "toolu-review",
  "version": "8.9.0",
  "description": "Evidence-backed review of committed changes for actionable defects, with complete-coverage push-review state. Standalone native-review fallback.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "review",
        "path": "skills/review/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "/bin/sh",
          "hooks/muse/session-start"
        ],
        "timeoutMs": 60000
      },
      {
        "id": "check-binary",
        "event": "SessionStart",
        "command": [
          "/bin/sh",
          "hooks/muse/check-binary"
        ],
        "timeoutMs": 60000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
