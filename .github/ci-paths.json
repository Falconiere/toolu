{
  "groups": {
    "docs": [
      "docs/**",
      "**/*.md"
    ],
    "rust": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      "rustfmt.toml",
      "clippy.toml",
      "deny.toml",
      "lefthook.yml",
      "crates/**",
      "vendor/**",
      ".cargo/**",
      ".claude/toolu.config.json",
      ".codex/toolu.config.json",
      "fixtures/**",
      "tooling/conventions/guardrails/rust/**",
      "plugins/rust-quality/**",
      "tools/toolu-cli/**",
      "plugins/*/hooks/hooks.json",
      "plugins/*/hooks/muse/*",
      "plugins/*/.claude-plugin/plugin.json",
      "plugins/*/.codex-plugin/plugin.json",
      "plugins/*/.muse-plugin/plugin.json",
      "plugins/*/agents/*.md",
      "docs/cli/**",
      "benchmarks/startup-budgets.json",
      "package-lock.json"
    ],
    "ports": [
      "fixtures/**",
      "benchmarks/cases/hooks/**",
      "benchmarks/hook-budgets.json",
      "plugins/**",
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      "crates/**",
      "vendor/**"
    ]
  },
  "runEverything": [
    ".github/**",
    "package-lock.json"
  ],
  "releaseOnly": {
    "paths": [
      "CHANGELOG.md",
      ".release-please-manifest.json",
      "Cargo.toml",
      "Cargo.lock",
      "package.json",
      "package-lock.json",
      "tools/*/npm/package.json",
      "plugins/*/.claude-plugin/plugin.json",
      "plugins/*/.codex-plugin/plugin.json",
      "plugins/*/.muse-plugin/plugin.json"
    ],
    "versionKeys": [
      "version",
      "."
    ]
  },
  "workflows": {
    "tests.yml": {
      "aggregate": "gate",
      "required": [],
      "jobs": {
        "docs": "docs",
        "rust": "rust",
        "rust-musl": "rust",
        "fuzz": "rust",
        "hook-bench": "ports"
      }
    },
    "toolu-review.yml": {
      "aggregate": null,
      "required": [
        "review"
      ],
      "jobs": {
        "review": "changed"
      }
    }
  }
}
