{
  "groups": {
    "ts": [
      "packages/**",
      "plugins/**",
      "tools/**",
      "tooling/**",
      "fixtures/**",
      "benchmarks/**",
      "package.json",
      "bun.lock",
      "tsconfig*.json",
      ".oxlintrc.json",
      ".oxfmtrc.json",
      "knip.json",
      ".jscpd.json",
      "guardrails.workspace.json",
      "release-please-config.json",
      "LICENSE",
      ".claude-plugin/**",
      ".agents/**"
    ],
    "opencode": [
      "tools/toolu-opencode/**",
      "tools/toolu-conformance/**",
      "plugins/**",
      "packages/toolu-core/**",
      "tooling/src/opencode-*/**",
      "tooling/src/opencode-*.ts",
      "tooling/src/env.ts",
      "tooling/src/npm-pack.ts",
      "fixtures/**",
      "docs/opencode.md",
      "docs/opencode-migration.md",
      "package.json",
      "bun.lock"
    ],
    "docs": ["docs/**", "**/*.md"],
    "rust": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      "rustfmt.toml",
      "clippy.toml",
      "deny.toml",
      "lefthook.yml",
      "crates/**",
      ".cargo/**",
      ".claude/toolu.config.json",
      ".codex/toolu.config.json",
      "fixtures/**",
      "tooling/conventions/guardrails/rust/**",
      "tooling/src/check-rust-quality.ts",
      "plugins/rust-quality/**",
      "plugins/*/hooks/hooks.json",
      "plugins/*/.claude-plugin/plugin.json",
      "plugins/*/.codex-plugin/plugin.json",
      "docs/cli/**",
      "benchmarks/startup-budgets.json",
      "packages/toolu-core/src/state/**",
      "packages/toolu-core/src/detect/**"
    ],
    "ports": [
      "fixtures/**",
      "tooling/src/rust-conformance.ts",
      "tooling/src/benchmarks/hook-resources.ts",
      "tooling/src/benchmarks/lib/hook-*.ts",
      "tooling/src/benchmarks/__tests__/hook-resources*.ts",
      "benchmarks/cases/hooks/**",
      "benchmarks/hook-budgets.json",
      "tools/toolu-conformance/**",
      "plugins/**",
      "packages/**",
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      "crates/**"
    ]
  },
  "runEverything": [".github/**", "bun.lock"],
  "releaseOnly": {
    "paths": [
      "CHANGELOG.md",
      ".release-please-manifest.json",
      "Cargo.toml",
      "Cargo.lock",
      "package.json",
      "packages/*/package.json",
      "tools/*/package.json",
      "tools/*/npm/package.json",
      "plugins/*/.claude-plugin/plugin.json",
      "plugins/*/.codex-plugin/plugin.json"
    ],
    "versionKeys": ["version", ".", "@toolu/core"]
  },
  "workflows": {
    "tests.yml": {
      "aggregate": "gate",
      "required": ["typescript"],
      "jobs": {
        "ts": "ts",
        "opencode": "opencode",
        "docs": "docs",
        "rust": "rust",
        "rust-musl": "rust",
        "fuzz": "rust",
        "rust-conformance": "ports",
        "hook-bench": "ports"
      }
    },
    "toolu-review.yml": {
      "aggregate": null,
      "required": ["review", "merge-gate"],
      "jobs": { "review": "changed" }
    }
  }
}
