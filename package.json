{
  "name": "toolu-workspace",
  "private": true,
  "version": "7.11.0",
  "description": "Engineering discipline for coding agents.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "skills",
    "hooks",
    "quality-gate"
  ],
  "scripts": {
    "generate:opencode-surface": "bun run tools/toolu-opencode/scripts/generate-surface.ts",
    "check:opencode-surface": "bun run tools/toolu-opencode/scripts/check-surface-drift.ts",
    "probe:opencode-host": "bun run tooling/src/opencode-host-probe.ts",
    "probe:opencode-surface": "bun run tooling/src/opencode-surface-probe.ts",
    "check:opencode-host": "bun run tooling/src/opencode-host-contract.ts",
    "check:opencode-docs": "bun run tooling/src/check-opencode-docs.ts",
    "smoke:opencode-entry": "bun run tooling/src/opencode-entry-smoke.ts",
    "smoke:opencode-pretool": "bun run tooling/src/opencode-pretool-smoke.ts",
    "smoke:opencode-permissions": "bun run tooling/src/opencode-permissions-smoke.ts",
    "smoke:opencode-posttool": "bun run tooling/src/opencode-posttool-smoke.ts",
    "smoke:opencode-ts-quality": "bun run tooling/src/opencode-ts-quality-smoke.ts",
    "smoke:opencode-python-quality": "bun run tooling/src/opencode-python-quality-smoke.ts",
    "smoke:opencode-rust-quality": "bun run tooling/src/opencode-rust-quality-smoke.ts",
    "smoke:opencode-ast-grep": "bun run tooling/src/opencode-ast-grep-smoke.ts",
    "build:plugins": "bun run tooling/src/build-plugins.ts",
    "bench:hooks": "bun run tooling/src/benchmarks/hook-resources.ts",
    "bench:final-hooks": "bun run tooling/src/benchmarks/final-hook-latency.ts && bun run tooling/src/benchmarks/post-tools-latency.ts",
    "bench:final-hooks:linux": "bun run tooling/src/benchmarks/linux-container.ts",
    "smoke:clean-install": "bun run tooling/src/clean-install-smoke.ts",
    "test:portable-core": "bun run tooling/src/check-portable-core-doc.ts && bun run check:opencode-host && bun run check:opencode-docs && bun test --timeout 60000 tooling/src/__tests__/check-portable-core-doc.test.ts tooling/src/__tests__/opencode-host-contract.test.ts tooling/src/__tests__/check-opencode-docs.test.ts tooling/src/opencode-host/__tests__",
    "check:rust-quality": "bun run tooling/src/check-rust-quality.ts",
    "check:http-musl": "bun run tooling/src/check-http-musl.ts",
    "check:markdown-cli": "cargo xtask check-markdown-cli",
    "test:conformance": "bun run tools/toolu-conformance/src/cli/run.ts",
    "test:rust-conformance": "bun run tooling/src/rust-conformance.ts",
    "test:unit": "bun test --timeout 60000 --path-ignore-patterns=**/*.native.test.ts tooling/src packages tools plugins",
    "test:opencode": "bun run tooling/src/opencode-acceptance.ts"
  },
  "dependencies": {
    "zod": "4.1.5",
    "@toolu/core": "workspace:*",
    "@toolu/opencode": "workspace:*",
    "@toolu/conformance": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "jscpd": "4.0.5",
    "knip": "5.63.1",
    "oxfmt": "^0.70.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "tooling",
    "packages/toolu-core",
    "tools/toolu-opencode",
    "tools/toolu-conformance",
    "tools/toolu-cli"
  ],
  "engines": {
    "bun": ">=1.4.0 <1.5.0"
  }
}
