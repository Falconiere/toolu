{
  "path": [
    "tooling/src",
    "packages/toolu-core/src",
    "tools/toolu-opencode/src",
    "tools/toolu-opencode/scripts",
    "tools/toolu-opencode/contract",
    "tools/toolu-conformance/src",
    "tools/toolu-cli/src",
    "plugins"
  ],
  "threshold": 0,
  "exitCode": 1,
  "minLines": 10,
  "minTokens": 60,
  "reporters": [
    "console"
  ],
  "gitignore": true,
  "ignore": [
    "**/__tests__/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/conventions/**",
    "**/hooks/dist/**",
    "**/plugins/pr-babysit/hooks/src/babysit/fixer-route.ts"
  ],
  "format": [
    "typescript",
    "tsx"
  ]
}
