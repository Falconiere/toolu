        "permissions.ts",
        "settings.ts",
        "__tests__"
      ],
      "runner": [
        "runner-read.ts",
        "runner-exec.ts",
        "runner-types.ts",
        "__tests__"
      ],
      "cli": [
        "__tests__"
      ],
      "rest": [
        "__tests__"
      ],
      "launcher": [
        "__tests__"
      ],
      "host": [
        "host-name.ts",
        "host-detect.ts",
        "host-events.ts",
        "host-roots.ts",
        "host-snapshot.ts",
        "host-encode.ts",
        "__tests__"
      ],
      "state": [
        "state-schema.ts",
        "state-io.ts",
        "state-git.ts",
        "gate-file.ts",
        "telemetry.ts",
        "state-sweeper.ts",
        "diff-sha.ts",
        "edit-records.ts",
        "__tests__"
      ],
      "registry": [
        "registry-types.ts",
        "registry-paths.ts",
        "registry-gate.ts",
        "registry-list.ts",
        "registry-run.ts",
        "registry-register.ts",
        "registry-prune.ts",
        "__tests__"
      ],
      "ledger": [
        "ledger-jq.ts",
        "ledger-parse.ts",
        "ledger-io.ts",
        "ledger-model.ts",
        "ledger-scope.ts",
        "ledger-check.ts",
        "ledger-run-context.ts",
        "ledger-run.ts",
        "ledger-commands.ts",
        "verdict-gates.ts",
        "verdict-review.ts",
        "verdict.ts",
        "glob.ts",
        "push-waiver.ts",
        "__tests__"
