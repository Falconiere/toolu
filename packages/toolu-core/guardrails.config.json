    "requireReadme": []
  },
  "fileSize": {
    "max": 300,
    "skipExtensions": [
      ".ts"
    ]
  },
  "functionSize": {
    "max": 60
  },
  "testDir": "__tests__",
  "testGlob": "*.test.ts",
  "barrelNames": [
    "index.ts",
    "index.tsx"
  ],
  "barrelExempt": [],
  "bannedDeps": [
    "axios",
    "yup",
    "joi",
    "valibot",
    "superstruct",
    "ajv"
  ],
  "requiredFiles": [],
  "secrets": {
    "neverTracked": [
      ".env",
      ".env.local"
    ]
  },
  "shadowConfigs": [],
  "ownedByLinter": [
    "folder-tree",
    "colocated-tests",
    "no-barrels",
    "filename-case",
    "patterns"
  ]
}
