{
  "$schema": "../../tooling/conventions/guardrails/schema.json",
  "version": 2,
  "srcRoot": "src",
  "src": {
    "topLevel": [
      "decision",
      "events",
      "bridge",
      "policy",
      "config",
      "runner",
      "launcher",
      "cli",
      "rest",
      "host",
      "state"
    ],
    "nested": {
      "decision": [
        "__tests__"
      ],
      "events": [
        "__tests__"
      ],
      "bridge": [
        "hook-map.ts",
        "test-helpers.ts",
        "__tests__"
      ],
      "policy": [
        "__tests__"
      ],
      "config": [
        "config-schema.ts",
        "config-load.ts",
        "config-read.ts",
        "quality-config.ts",
        "docs-sync-config.ts",
        "gate-mode.ts",
        "permissions.ts",
        "settings.ts",
        "__tests__"
      ],
      "runner": [
        "runner-read.ts",
        "runner-exec.ts",
        "runner-types.ts",
        "__tests__"
      ],
      "cli": [
        "__tests__"
      ],
      "rest": [
        "__tests__"
      ],
      "launcher": [
        "__tests__"
      ],
      "host": [
        "host-name.ts",
        "host-detect.ts",
        "host-events.ts",
        "host-roots.ts",
        "host-snapshot.ts",
        "host-encode.ts",
        "__tests__"
      ],
      "state": [
        "state-schema.ts",
        "state-io.ts",
        "state-git.ts",
        "gate-file.ts",
        "telemetry.ts",
        "state-sweeper.ts",
        "diff-sha.ts",
        "edit-records.ts",
        "__tests__"
      ]
    },
    "requireReadme": []
  },
  "fileSize": {
    "max": 300,
    "skipExtensions": [
      ".ts"
    ]
  },
  "functionSize": {
    "max": 60
  },
  "testDir": "__tests__",
  "testGlob": "*.test.ts",
  "barrelNames": [
    "index.ts",
    "index.tsx"
  ],
  "barrelExempt": [],
  "bannedDeps": [
    "axios",
    "yup",
    "joi",
    "valibot",
    "superstruct",
    "ajv"
  ],
  "requiredFiles": [],
  "secrets": {
    "neverTracked": [
      ".env",
      ".env.local"
    ]
  },
  "shadowConfigs": [],
  "ownedByLinter": [
    "folder-tree",
    "colocated-tests",
    "no-barrels",
    "filename-case",
    "patterns"
  ]
}
