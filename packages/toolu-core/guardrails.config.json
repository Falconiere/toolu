{
  "$schema": "../../tooling/conventions/guardrails/schema.json",
  "version": 2,
  "srcRoot": "src",
  "src": {
    "topLevel": [
      "decision",
      "events",
      "bridge",
      "policy",
      "config",
      "runner"
    ],
    "nested": {
      "decision": [
        "__tests__"
      ],
      "events": [
        "__tests__"
      ],
      "bridge": [
        "hook-map.ts",
        "test-helpers.ts",
        "__tests__"
      ],
      "policy": [
        "__tests__"
      ],
      "config": [
        "__tests__"
      ],
      "runner": [
        "runner-read.ts",
        "runner-exec.ts",
        "runner-types.ts",
        "__tests__"
      ]
    },
    "requireReadme": []
  },
  "fileSize": {
    "max": 300,
    "skipExtensions": [
      ".ts"
    ]
  },
  "functionSize": {
    "max": 60
  },
  "testDir": "__tests__",
  "testGlob": "*.test.ts",
  "barrelNames": [
    "index.ts",
    "index.tsx"
  ],
  "barrelExempt": [],
  "bannedDeps": [
    "axios",
    "yup",
    "joi",
    "valibot",
    "superstruct",
    "ajv"
  ],
  "requiredFiles": [],
  "secrets": {
    "neverTracked": [
      ".env",
      ".env.local"
    ]
  },
  "shadowConfigs": [],
  "ownedByLinter": [
    "folder-tree",
    "colocated-tests",
    "no-barrels",
    "filename-case",
    "patterns"
  ]
}
