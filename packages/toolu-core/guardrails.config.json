{
  "$schema": "../../tooling/conventions/guardrails/schema.json",
  "version": 2,
  "srcRoot": "src",
  "src": {
    "topLevel": [
      "decision",
      "events",
      "bridge",
      "policy",
      "config",
      "runner",
      "launcher",
      "cli",
      "rest",
      "host",
      "state",
      "registry",
      "ledger",
      "startup",
      "dispatch",
      "shell"
