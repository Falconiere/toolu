    "nested": {
      "decision": [
        "__tests__"
      ],
      "events": [
        "__tests__"
      ],
      "bridge": [
        "hook-map.ts",
        "test-helpers.ts",
        "__tests__"
      ],
      "policy": [
        "__tests__"
      ],
      "config": [
        "config-schema.ts",
        "config-load.ts",
        "config-read.ts",
