        "publish.ts",
        "dependencies.ts",
        "__tests__"
      ],
      "dispatch": [
        "dispatch-bash.ts",
        "dispatch-context.ts",
        "dispatch-output.ts",
        "dispatch-walk.ts",
        "__tests__"
      ],
      "shell": [
        "shell-types.ts",
        "shell-options.ts",
        "shell-words.ts",
        "shell-walk-words.ts",
        "shell-argv.ts",
        "shell-walk.ts",
        "shell-parse.ts",
        "shell-git.ts",
        "shell-writes.ts",
        "shell-rules.ts",
        "shell-event.ts",
        "__tests__"
      ]
