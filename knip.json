{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "tooling": {
      "entry": [
        "src/benchmarks/ast-grep-latency.ts",
        "src/benchmarks/pre-tools-latency.ts",
        "src/benchmarks/post-tools-latency.ts",
        "src/benchmarks/python-quality-latency.ts",
        "src/benchmarks/rust-quality-latency.ts",
        "src/benchmarks/ts-quality-latency.ts",
        "src/codex-smoke.ts",
        "src/probe-ask.ts",
        "src/pr-babysit-herdr-smoke.ts",
        "src/validate-plugin-packaging.ts",
        "src/**/__tests__/**"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignore": [
        "fixtures/**",
        "conventions/**",
        "__tests__/**"
      ]
    },
    "packages/toolu-core": {
      "entry": [
        "src/**/*.ts!",
        "src/**/__tests__/**"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "tools/toolu-opencode": {
      "entry": [
        "src/**/*.ts!",
        "src/**/__tests__/**"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "tools/toolu-conformance": {
      "entry": [
        "src/**/*.ts!",
        "src/**/__tests__/**"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "tools/toolu-cli": {
      "entry": [
        "src/cli.ts!",
        "src/**/__tests__/**"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "ignoreBinaries": [
    "bats"
  ],
  "ignoreDependencies": [
    "oxlint",
    "oxlint-tsgolint"
  ]
}
