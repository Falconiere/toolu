{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "plugins/*/hooks/src/*.ts!",
        "plugins/*/hooks/src/**/__tests__/**",
        "plugins/*/scripts/*.ts!",
        "plugins/*/scripts/**/__tests__/**",
        "plugins/*/skills/**/*.ts"
      ],
      "project": [
        "plugins/*/hooks/src/**/*.ts",
        "plugins/*/scripts/**/*.ts",
        "plugins/*/skills/**/*.ts"
      ],
      "ignore": [
        "plugins/ast-grep/hooks/src/lib/savings-measure.ts",
        "plugins/ast-grep/hooks/src/lib/savings-report.ts",
        "plugins/epic-orchestrator/scripts/trackers/jira.ts",
        "plugins/epic-orchestrator/scripts/trackers/linear.ts",
        "plugins/epic-orchestrator/scripts/watch/state.ts",
        "plugins/jev/hooks/src/jev/availability.ts",
        "plugins/jev/hooks/src/jev/parse.ts",
        "plugins/pr-babysit/hooks/src/babysit/collect.ts",
        "plugins/pr-babysit/hooks/src/babysit/common.ts",
        "plugins/pr-babysit/hooks/src/babysit/fixer-dispatch.ts",
        "plugins/pr-babysit/hooks/src/babysit/fixer-route.ts",
        "plugins/pr-babysit/hooks/src/babysit/verdict.ts",
        "plugins/python-quality/hooks/src/rules/py-file.ts",
        "plugins/rust-quality/hooks/src/rules/layout-rules.ts",
        "plugins/statusline/hooks/src/statusline/collect.ts",
        "plugins/toolu/hooks/src/lifecycle/bash-compat.ts",
        "plugins/toolu/hooks/src/lifecycle/dependency-warning.ts",
        "plugins/toolu/hooks/src/lifecycle/prompt-hints.ts",
        "plugins/toolu/hooks/src/lifecycle/session-docs.ts",
        "plugins/toolu/hooks/src/lifecycle/tool-mandates.ts",
        "plugins/ts-quality/hooks/src/rules/advisories.ts",
        "plugins/ts-quality/hooks/src/rules/ts-file.ts"
      ]
    },
    "tooling": {
      "entry": [
        "src/benchmarks/ast-grep-latency.ts",
        "src/benchmarks/python-quality-latency.ts",
        "src/benchmarks/rust-quality-latency.ts",
        "src/benchmarks/ts-quality-latency.ts",
        "src/codex-smoke.ts",
        "src/opencode-host/mcp-server.ts",
        "src/opencode-tool-capture.ts",
        "src/probe-ask.ts",
        "src/pr-babysit-herdr-smoke.ts",
        "src/validate-plugin-packaging.ts",
        "src/**/__tests__/**"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignore": [
        "fixtures/**",
        "conventions/**",
        "__tests__/**"
      ]
    },
    "packages/toolu-core": {
      "entry": [
        "src/**/*.ts!",
        "src/**/__tests__/**"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "tools/toolu-opencode": {
      "entry": [
        "src/**/*.ts!",
        "src/**/__tests__/**",
        "contract/**/*.ts",
        "scripts/*.ts",
        "scripts/**/__tests__/**"
      ],
      "project": [
        "src/**/*.ts",
        "contract/**/*.ts",
        "scripts/**/*.ts"
      ],
      "ignore": [
        "scripts/lib/emit.ts",
        "scripts/lib/frontmatter.ts",
        "scripts/lib/opencode-port.ts",
        "scripts/lib/rewrite.ts",
        "scripts/lib/scan-surface.ts"
      ]
    },
    "tools/toolu-conformance": {
      "entry": [
        "src/**/*.ts!",
        "src/**/__tests__/**"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "tools/toolu-cli": {
      "entry": [
        "src/cli.ts!",
        "src/**/__tests__/**"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "ignoreDependencies": [
    "oxlint",
    "oxlint-tsgolint"
  ]
}
