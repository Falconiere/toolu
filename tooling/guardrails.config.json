{
  "$schema": "./conventions/guardrails/schema.json",
  "version": 2,
  "srcRoot": "src",
  "src": {
    "topLevel": ["benchmarks", "gate-coverage", "gate-reach", "guardrails", "opencode-acceptance", "opencode-host", "__tests__"],
    "nested": {
      "benchmarks": ["__tests__", "cases", "lib"],
      "gate-coverage": ["__tests__"],
      "gate-reach": ["__tests__"],
      "guardrails": ["__tests__", "checks", "lexer"],
      "opencode-acceptance": ["__tests__"],
      "opencode-host": ["__tests__"]
    },
    "requireReadme": []
  },
  "fileSize": {
    "max": 300,
    "skipExtensions": [".ts"]
  },
  "functionSize": {
    "max": 60
  },
  "testDir": "__tests__",
  "testGlob": "*.test.ts",
  "barrelNames": ["index.ts", "index.tsx"],
  "barrelExempt": [],
  "bannedDeps": ["axios", "yup", "joi", "valibot", "superstruct", "ajv"],
  "requiredFiles": [],
  "secrets": {
    "neverTracked": [".env", ".env.local"]
  },
  "shadowConfigs": [
    {
      "found": "lefthook.yaml",
      "use": "lefthook.yml",
      "why": "lefthook 2.x installer shadows .yaml"
    }
  ],
  "ownedByLinter": [
    "folder-tree",
    "colocated-tests",
    "no-barrels",
    "filename-case",
    "patterns"
  ]
}
