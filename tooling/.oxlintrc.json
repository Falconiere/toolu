{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": ["./conventions/lint/base.oxlintrc.json"],
  "jsPlugins": ["./conventions/guardrails/oxlint-plugin/index.js"],
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "node_modules",
    "fixtures",
    "conventions/guardrails/oxlint-plugin"
  ],
  "rules": {
    "max-lines": ["error", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["error", { "max": 60, "skipBlankLines": true, "skipComments": true }],
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "house/folder-tree": "error",
    "house/colocated-tests": "error",
    "house/no-barrels": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/index", "**/index.js", "**/index.ts"],
            "message": "No barrel imports — import the concrete file"
          },
          {
            "group": ["yup", "yup/*", "joi", "joi/*", "valibot", "valibot/*", "superstruct", "superstruct/*", "ajv", "ajv/*"],
            "message": "One validator: use zod"
          },
          {
            "group": ["@opencode/plugin", "@opencode/plugin/*"],
            "message": "Host SDK must not enter shared tooling/core"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-globals": "off"
      }
    }
  ]
}
