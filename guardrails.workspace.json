{
  "$schema": "./tooling/conventions/guardrails/workspace.schema.json",
  "version": 2,
  "packages": [
    "tooling",
    "packages/toolu-core",
    "tools/toolu-opencode",
    "tools/toolu-conformance",
    "tools/toolu-cli"
  ],
  "bannedDeps": [
    "axios",
    "yup",
    "joi",
    "valibot",
    "superstruct",
    "ajv"
  ],
  "secrets": {
    "neverTracked": [
      ".env",
      ".env.local"
    ]
  },
  "shadowConfigs": [
    {
      "found": "lefthook.yaml",
      "use": "lefthook.yml",
      "why": "lefthook 2.x installer shadows .yaml \u2014 documented only; this repo does not install Lefthook as a Claude hook pipeline"
    }
  ]
}
