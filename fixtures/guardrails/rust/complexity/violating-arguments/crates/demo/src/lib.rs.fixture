//! A fixture crate.

/// Add one, saturating at the top.
pub fn bump(value: u8) -> u8 {
  value.saturating_add(1)
}

/// Sum six values.
pub fn six(a: u8, b: u8, c: u8, d: u8, e: u8, f: u8) -> u32 {
  u32::from(a) + u32::from(b) + u32::from(c) + u32::from(d) + u32::from(e) + u32::from(f)
}

