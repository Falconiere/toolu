    {
      "name": "a feature branch has a nonempty content hash",
      "kind": "diff-sha",
      "git": true,
      "files": {
        "a.txt": "one\n"
      },
      "steps": [
        {
          "op": "git",
          "args": ["checkout", "-q", "-b", "feat/x"]
        },
        {
          "op": "write",
          "path": "a.txt",
          "body": "one\ntwo  é\n"
        },
        {
          "op": "write",
          "path": "b.bin",
          "body": "\u0000\u0001binary"
        },
        {
          "op": "git",
          "args": ["add", "-A"]
        },
        {
          "op": "git",
          "args": ["commit", "-q", "-m", "change"]
        }
      ],
      "base": "main",
      "expect": "nonempty-hash",
      "notHash": "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391"
    },
