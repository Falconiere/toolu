{
  "version": 1,
  "cases": [
    {
      "name": "session-start: startup in a fresh repo",
      "hook": "session-start",
      "stdin": "{\"hook_event_name\":\"SessionStart\",\"source\":\"startup\"}"
    },
    {
      "name": "session-start: resume",
      "hook": "session-start",
      "stdin": "{\"source\":\"resume\"}"
    },
    {
      "name": "session-start: clear",
      "hook": "session-start",
      "stdin": "{\"source\":\"clear\"}"
    },
    {
      "name": "session-start: compact adds the post-compaction doc",
      "hook": "session-start",
      "stdin": "{\"source\":\"compact\"}"
    },
    {
      "name": "session-start: an unknown source gets no title and no main doc",
      "hook": "session-start",
      "stdin": "{\"source\":\"reboot\"}"
    },
    {
      "name": "session-start: a numeric source is an unknown event",
      "hook": "session-start",
      "stdin": "{\"source\":7}"
    },
    {
      "name": "session-start: legacy session_event field",
      "hook": "session-start",
      "stdin": "{\"session_event\":\"resume\"}"
    },
    {
      "name": "session-start: a false source falls through like jq //",
      "hook": "session-start",
      "stdin": "{\"source\":false,\"event\":\"resume\"}"
    },
    {
      "name": "session-start: empty stdin is startup",
      "hook": "session-start",
      "stdin": ""
    },
    {
      "name": "session-start: invalid JSON stdin is startup",
      "hook": "session-start",
      "stdin": "{not json"
    },
    {
      "name": "session-start: outside a git repo",
      "hook": "session-start",
      "stdin": "{\"hook_event_name\":\"SessionStart\",\"source\":\"startup\"}",
      "git": false
    },
    {
      "name": "session-start: a feature branch names itself",
      "hook": "session-start",
      "stdin": "{\"hook_event_name\":\"SessionStart\",\"source\":\"startup\"}",
      "branch": "feat/live-thing"
    },
    {
      "name": "session-start: project name with sed metacharacters",
      "hook": "session-start",
      "stdin": "{\"hook_event_name\":\"SessionStart\",\"source\":\"startup\"}",
      "subdir": "we|ird&name"
    },
    {
      "name": "session-start: dirty tree and failing gate stay out of the prefix",
      "hook": "session-start",
