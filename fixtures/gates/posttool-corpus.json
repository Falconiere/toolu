    {
      "name": "push-waiver: a successful push promotes the waiver",
      "expect": "silent",
      "setupByHost": {
        "claude": [
          {
            "op": "git",
            "args": [
              "-C",
              {
                "$path": "$PROJECT"
              },
              "checkout",
              "-q",
              "-b",
              "feat/example"
            ]
          },
          {
            "op": "write",
            "path": "$PROJECT/src/a.ts",
            "body": "export const a = 1;\n"
          },
          {
            "op": "git",
            "args": [
              "-C",
              {
                "$path": "$PROJECT"
              },
              "add",
              "-A"
            ]
          },
          {
            "op": "git",
            "args": [
              "-C",
              {
                "$path": "$PROJECT"
              },
              "commit",
              "-q",
              "-m",
              "feat: example"
            ]
          },
          {
            "op": "push-waiver-pend",
            "slug": "feat_example",
            "base": "main",
            "reasonCode": "no-state"
          }
        ],
        "codex": [
          {
            "op": "git",
            "args": [
              "-C",
              {
                "$path": "$PROJECT"
              },
              "checkout",
              "-q",
              "-b",
              "feat/example"
            ]
          },
          {
            "op": "write",
            "path": "$PROJECT/src/a.ts",
            "body": "export const a = 1;\n"
          },
          {
            "op": "git",
            "args": [
              "-C",
              {
                "$path": "$PROJECT"
              },
              "add",
              "-A"
            ]
          },
          {
            "op": "git",
            "args": [
              "-C",
              {
                "$path": "$PROJECT"
              },
              "commit",
              "-q",
              "-m",
              "feat: example"
            ]
          },
          {
            "op": "push-waiver-pend",
            "slug": "feat_example",
            "base": "main",
            "reasonCode": "no-state"
          }
        ]
      },
      "fixture": {
        "kind": "tool",
