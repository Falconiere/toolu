{
  "version": 1,
  "cases": [
    {
      "name": "gate-status: failing quality command advises",
      "expect": "advisory",
      "setupByHost": {
        "claude": [],
        "codex": []
      },
      "fixture": {
        "kind": "tool",
        "event": "PostToolUse",
        "toolName": "Bash",
        "toolInput": {
          "command": "bun test"
        },
        "toolResponse": {
          "metadata": {
            "exit_code": 1
          },
          "stdout": "",
          "stderr": ""
        }
      }
    },
