    {
      "name": "registry: a written file reaches a module with its path",
      "expect": "advisory",
      "setupByHost": {
        "claude": [
          {
            "op": "write",
            "path": "$HOME/.claude/toolu/post-tools.d/fixture@toolu__gate.sh",
            "body": "#!/usr/bin/env bash\n. \"$TOOLU_LIB_DIR/detect.sh\"\n. \"$TOOLU_LIB_DIR/gate-file.sh\"\nfile=$(jq -r '.tool_input.file_path // empty' <<<\"$input\")\n[ -n \"$file\" ] || exit 0\ngate=\"$(toolu_project_state_root \"$PROJECT_ROOT\")/quality-gate-status.json\"\nmkdir -p \"${gate%/*}\"\ngate_record_failure \"$gate\" \"$file\" fixture-hook \"fixture violation\" \"fixture violation in $file\"\njq -n --arg e PostToolUse --arg ctx \"fixture violation in $file\" '{hookSpecificOutput:{hookEventName:$e,additionalContext:$ctx}}'\n"
          },
          {
            "op": "write",
            "path": "$PROJECT/src/bad.txt",
            "body": "bad\n"
          }
        ],
        "codex": [
          {
            "op": "write",
            "path": "$HOME/.codex/toolu/post-tools.d/fixture@toolu__gate.sh",
            "body": "#!/usr/bin/env bash\n. \"$TOOLU_LIB_DIR/detect.sh\"\n. \"$TOOLU_LIB_DIR/gate-file.sh\"\nfile=$(jq -r '.tool_input.file_path // empty' <<<\"$input\")\n[ -n \"$file\" ] || exit 0\ngate=\"$(toolu_project_state_root \"$PROJECT_ROOT\")/quality-gate-status.json\"\nmkdir -p \"${gate%/*}\"\ngate_record_failure \"$gate\" \"$file\" fixture-hook \"fixture violation\" \"fixture violation in $file\"\njq -n --arg e PostToolUse --arg ctx \"fixture violation in $file\" '{hookSpecificOutput:{hookEventName:$e,additionalContext:$ctx}}'\n"
          },
          {
            "op": "write",
            "path": "$PROJECT/src/bad.txt",
            "body": "bad\n"
          }
        ]
      },
      "fixture": {
        "kind": "tool",
        "event": "PostToolUse",
        "toolName": "Write",
        "toolInput": {
          "file_path": {
            "$path": "$PROJECT/src/bad.txt"
          },
          "content": "bad\n"
        },
        "toolResponse": {
          "success": true
        }
      }
    },
