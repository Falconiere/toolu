    {
      "name": "gate-status: a file-hook failure survives a passing command",
      "expect": "silent",
      "setupByHost": {
        "claude": [
          {
            "op": "write",
            "path": "$PROJECT/.claude/tmp/quality-gate-status.json",
            "body": "{\n  \"status\": \"failing\",\n  \"source\": \"ts-quality-hook\",\n  \"reason\": \"bad ts\",\n  \"violations\": \"viol\\n\",\n  \"updatedAt\": \"2026-01-01T00:00:00Z\",\n  \"file\": \"/p/a.ts\",\n  \"entries\": {\n    \"/p/a.ts\": {\n      \"source\": \"ts-quality-hook\",\n      \"reason\": \"bad ts\",\n      \"violations\": \"viol\\n\",\n      \"updatedAt\": \"2026-01-01T00:00:00Z\"\n    }\n  }\n}\n"
          }
        ],
        "codex": [
          {
            "op": "write",
            "path": "$PROJECT/.codex/tmp/quality-gate-status.json",
            "body": "{\n  \"status\": \"failing\",\n  \"source\": \"ts-quality-hook\",\n  \"reason\": \"bad ts\",\n  \"violations\": \"viol\\n\",\n  \"updatedAt\": \"2026-01-01T00:00:00Z\",\n  \"file\": \"/p/a.ts\",\n  \"entries\": {\n    \"/p/a.ts\": {\n      \"source\": \"ts-quality-hook\",\n      \"reason\": \"bad ts\",\n      \"violations\": \"viol\\n\",\n      \"updatedAt\": \"2026-01-01T00:00:00Z\"\n    }\n  }\n}\n"
          }
        ]
      },
