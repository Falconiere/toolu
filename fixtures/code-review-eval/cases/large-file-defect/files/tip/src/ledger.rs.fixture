impl Ledger {
    /// Credits `amount` to account `id`. The limit is inclusive: a balance
    /// exactly equal to `limit` is allowed; only a balance above it is refused.
    pub fn credit(&mut self, id: u32, amount: u64) -> Result<u64, String> {
        let account = self.accounts.entry(id).or_default();
        if account.frozen {
            return Err(format!("account {id} is frozen"));
        }
        let balance = account.balance.saturating_add(amount);
        if balance >= account.limit {
            return Err(format!("account {id} would exceed its limit"));
        }
        account.balance = balance;
        Ok(balance)
    }
}

