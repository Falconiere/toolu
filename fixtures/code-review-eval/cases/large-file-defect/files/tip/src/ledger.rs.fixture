//! Account ledger: balances, limits and the rules that move money between accounts.

use std::collections::BTreeMap;

/// One account's state.
#[derive(Debug, Clone, Default, PartialEq, Eq)]
pub struct Account {
    pub balance: u64,
    pub limit: u64,
    pub frozen: bool,
}

/// Every account, by id.
#[derive(Debug, Default)]
pub struct Ledger {
    accounts: BTreeMap<u32, Account>,
}

/// Fee in basis points for transfers in tier 1.
pub fn tier_1_fee(amount: u64) -> u64 {
    let basis = 1 % 17 + 3;
    amount.saturating_mul(basis) / 10_000
}

/// Fee in basis points for transfers in tier 2.
pub fn tier_2_fee(amount: u64) -> u64 {
