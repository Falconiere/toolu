{
  "version": 1,
  "cases": [
    {
      "name": "each host has its native user root",
      "kind": "calls",
      "git": false,
      "dirs": [],
      "checks": [
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u"
              },
              "host": "claude"
            }
          ],
          "expected": "/home/u/.claude"
        },
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u"
              },
              "host": "codex"
            }
          ],
          "expected": "/home/u/.codex"
        },
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u"
              },
              "host": "cursor"
            }
          ],
          "expected": "/home/u/.cursor"
        },
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u"
              },
              "host": "hermes"
            }
          ],
          "expected": "/home/u/.hermes"
        },
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u"
              },
              "host": "opencode"
            }
          ],
          "expected": "/home/u/.config/opencode"
        }
      ]
    },
    {
      "name": "host-native overrides apply to their own host only",
      "kind": "calls",
      "git": false,
      "dirs": [],
      "checks": [
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u",
                "CLAUDE_CONFIG_DIR": "/cc",
                "CODEX_HOME": "/cx",
                "HERMES_HOME": "/hh",
                "XDG_CONFIG_HOME": "/xdg"
              },
              "host": "claude"
            }
          ],
          "expected": "/cc"
        },
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u",
                "CLAUDE_CONFIG_DIR": "/cc",
                "CODEX_HOME": "/cx",
                "HERMES_HOME": "/hh",
                "XDG_CONFIG_HOME": "/xdg"
              },
              "host": "codex"
            }
          ],
          "expected": "/cx"
        },
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u",
                "CLAUDE_CONFIG_DIR": "/cc",
                "CODEX_HOME": "/cx",
                "HERMES_HOME": "/hh",
                "XDG_CONFIG_HOME": "/xdg"
              },
              "host": "hermes"
            }
          ],
          "expected": "/hh"
        },
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u",
                "CLAUDE_CONFIG_DIR": "/cc",
                "CODEX_HOME": "/cx",
                "HERMES_HOME": "/hh",
                "XDG_CONFIG_HOME": "/xdg"
              },
              "host": "opencode"
            }
          ],
          "expected": "/xdg/opencode"
        },
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u",
                "CLAUDE_CONFIG_DIR": "/cc",
                "CODEX_HOME": "/cx",
                "HERMES_HOME": "/hh",
                "XDG_CONFIG_HOME": "/xdg"
              },
              "host": "cursor"
            }
          ],
          "expected": "/home/u/.cursor"
        },
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u",
                "CLAUDE_CONFIG_DIR": "/cc",
                "CODEX_HOME": "/cx",
                "HERMES_HOME": "/hh",
                "XDG_CONFIG_HOME": "/xdg",
                "TOOLU_OPENCODE_HOME": "/oc"
              },
              "host": "opencode"
            }
          ],
          "expected": "/oc"
        }
      ]
    },
    {
      "name": "TOOLU_CONFIG_DIR wins on every host",
      "kind": "calls",
      "git": false,
      "dirs": [],
      "checks": [
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u",
                "TOOLU_CONFIG_DIR": "/explicit",
                "CODEX_HOME": "/wrong"
              },
              "host": "claude"
            }
          ],
          "expected": "/explicit"
        },
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u",
                "TOOLU_CONFIG_DIR": "/explicit",
                "CODEX_HOME": "/wrong"
              },
              "host": "codex"
            }
          ],
          "expected": "/explicit"
        },
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u",
                "TOOLU_CONFIG_DIR": "/explicit",
                "CODEX_HOME": "/wrong"
              },
              "host": "cursor"
            }
          ],
          "expected": "/explicit"
        },
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u",
                "TOOLU_CONFIG_DIR": "/explicit",
                "CODEX_HOME": "/wrong"
              },
              "host": "hermes"
            }
          ],
          "expected": "/explicit"
        },
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u",
                "TOOLU_CONFIG_DIR": "/explicit",
                "CODEX_HOME": "/wrong"
              },
              "host": "opencode"
            }
          ],
          "expected": "/explicit"
        }
      ]
    },
    {
      "name": "detects the host from env when none is given",
      "kind": "calls",
      "git": false,
      "dirs": [],
      "checks": [
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {
                "HOME": "/home/u",
                "PLUGIN_ROOT": "/p"
              }
            }
          ],
          "expected": "/home/u/.codex"
        }
      ]
    },
    {
      "name": "an unset HOME falls back to the OS home directory",
      "kind": "calls",
      "git": false,
      "dirs": [],
      "checks": [
        {
          "fn": "configRoot",
          "args": [
            {
              "env": {},
              "host": "claude"
            }
          ],
          "expected": {
            "$runtime": "OS_CLAUDE_HOME"
          }
        }
      ]
    },
    {
      "name": "TOOLU_PROJECT_DIR wins, then the host's project variable",
      "kind": "calls",
      "git": false,
      "dirs": [],
      "checks": [
        {
          "fn": "projectRoot",
          "args": [
            {
              "env": {
                "TOOLU_PROJECT_DIR": "/t",
                "CLAUDE_PROJECT_DIR": "/c",
                "CURSOR_PROJECT_DIR": "/k"
              },
              "host": "claude"
            }
          ],
          "expected": "/t"
        },
        {
          "fn": "projectRoot",
          "args": [
            {
              "env": {
                "CLAUDE_PROJECT_DIR": "/c",
                "CURSOR_PROJECT_DIR": "/k"
              },
              "host": "claude"
            }
          ],
          "expected": "/c"
        },
        {
          "fn": "projectRoot",
          "args": [
            {
              "env": {
                "CLAUDE_PROJECT_DIR": "/c",
                "CURSOR_PROJECT_DIR": "/k"
              },
              "host": "cursor"
            }
          ],
          "expected": "/k"
        }
      ]
    },
    {
      "name": "Codex ignores CLAUDE_PROJECT_DIR and falls back to the git toplevel of cwd",
      "kind": "calls",
      "git": true,
      "dirs": ["src"],
      "checks": [
        {
          "fn": "projectRoot",
          "args": [
            {
              "env": {
                "PATH": {
                  "$runtime": "PATH"
                },
                "CLAUDE_PROJECT_DIR": "/c"
              },
              "host": "codex",
              "cwd": {
                "$path": "$PROJECT/src"
              }
            }
          ],
          "expected": {
            "$path": "$PROJECT"
          }
        }
      ]
    },
    {
      "name": "git runs with the caller's env, not the ambient one",
      "kind": "calls",
      "git": true,
      "dirs": ["src"],
      "checks": [
        {
          "fn": "projectRoot",
          "args": [
            {
              "env": {
                "PATH": {
                  "$runtime": "PATH"
                }
              },
              "host": "codex",
              "cwd": {
                "$path": "$PROJECT"
              }
            }
          ],
          "expected": {
            "$path": "$PROJECT"
          }
        },
        {
          "fn": "projectRoot",
          "args": [
            {
              "env": {
                "PATH": {
                  "$runtime": "PATH"
                },
                "GIT_CEILING_DIRECTORIES": {
                  "$path": "$PROJECT"
                }
              },
              "host": "codex",
              "cwd": {
                "$path": "$PROJECT/src"
              }
            }
          ],
          "expected": null
        }
      ]
    },
    {
      "name": "outside a git repository there is no project root and no project paths",
      "kind": "calls",
      "git": false,
      "dirs": ["$ROOT/outside"],
      "checks": [
        {
          "fn": "projectRoot",
          "args": [
            {
              "env": {
                "PATH": {
                  "$runtime": "PATH"
                }
              },
              "host": "claude",
              "cwd": {
                "$path": "$ROOT/outside"
              }
            }
          ],
          "expected": null
        },
        {
          "fn": "projectConfigPath",
          "args": [
            {
              "env": {
                "PATH": {
                  "$runtime": "PATH"
                }
              },
              "host": "claude",
              "cwd": {
                "$path": "$ROOT/outside"
              }
            }
          ],
          "expected": null
        },
        {
          "fn": "projectStateRoot",
          "args": [
            {
              "env": {
                "PATH": {
                  "$runtime": "PATH"
                }
              },
              "host": "claude",
              "cwd": {
                "$path": "$ROOT/outside"
              }
            }
          ],
          "expected": null
        },
        {
          "fn": "projectStateDir",
          "args": [
            "telemetry",
            {
              "env": {
                "PATH": {
                  "$runtime": "PATH"
                }
              },
              "host": "claude",
              "cwd": {
                "$path": "$ROOT/outside"
              }
            }
          ],
          "expected": null
        }
      ]
    },
