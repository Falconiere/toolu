        },
        {
          "fn": "projectStateRoot",
          "args": [
            {
              "env": {
                "TOOLU_PROJECT_DIR": "/repo",
                "TOOLU_PROJECT_CONFIG_DIRNAME": ".test-state"
              },
              "host": "codex",
              "root": "/other"
