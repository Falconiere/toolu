              "host": "codex"
            }
          ],
          "expected": "/codex-root"
        },
        {
          "fn": "pluginRoot",
          "args": [
            {
              "env": {
                "PLUGIN_ROOT": "/codex-root",
                "PLUGIN_DATA": "/codex-data",
                "CURSOR_PLUGIN_ROOT": "/cursor-root",
                "TOOLU_PLUGIN_ROOT": "/oc-root",
                "CLAUDE_PLUGIN_ROOT": "/claude-root",
                "CLAUDE_PLUGIN_DATA": "/claude-data"
              },
              "host": "cursor"
            }
          ],
          "expected": "/cursor-root"
