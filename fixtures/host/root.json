    {
      "name": "TOOLU_PROJECT_CONFIG_DIRNAME and an explicit root override the defaults",
      "kind": "calls",
      "git": false,
      "dirs": [],
      "checks": [
        {
          "fn": "projectStateDir",
          "args": [
            "telemetry",
